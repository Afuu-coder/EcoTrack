# EcoTrack — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local — it is in .gitignore.

# ── Firebase (from Firebase Console → Project Settings → Your Apps) ──
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123def456

# ── Cloud Run backend (from Cloud Run → Service URL) ──
# Only needed if you deploy the Express backend for Vertex AI
VITE_CLOUD_RUN_API_URL=https://ecotrack-api-xyz.run.app
